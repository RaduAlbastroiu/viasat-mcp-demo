# Port for the HTTP transport (DigitalOcean sets PORT itself)
PORT=8080
# Public URL of the hosted Business Hub app, used for open-in-app deep links
BUSINESS_HUB_URL=https://mcp-demo-app-o6moq.ondigitalocean.app
# Tool set to expose: internal (all tools, default) | integrator | operator | commercial
MCP_PERSONA=internal
# Fleet time simulation: on | off, and minutes of drift per real minute for degraded/offline devices
FLEET_SIMULATION=on
FLEET_DRIFT=1
# Monitor script only (npm run monitor): where the MCP server is, and the model to use
MCP_URL=http://localhost:8080/mcp
MONITOR_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=   (monitor script only; never needed by the server itself)
