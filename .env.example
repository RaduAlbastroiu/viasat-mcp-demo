# Port for the HTTP transport (DigitalOcean sets PORT itself)
PORT=8080
# Public URL of the hosted Business Hub app, used for open-in-app deep links
BUSINESS_HUB_URL=https://mcp-demo-app-o6moq.ondigitalocean.app
# Tool set to expose: internal (all tools, default) | integrator | operator | commercial
MCP_PERSONA=internal
# Fleet time simulation: on | off, and minutes of drift per real minute for degraded/offline devices
FLEET_SIMULATION=on
FLEET_DRIFT=1
# Rolling incidents: every window one healthy device goes silent (degraded after 15 min, past the 60-min threshold after
# an hour) and reports again when the next window starts, so the monitor finds something new every window. off to disable.
# Keep the window longer than the ticket threshold, or the device recovers before it can be ticketed.
FLEET_INCIDENTS=on
FLEET_INCIDENT_EVERY=2h
# /api/monitor reports status "silent" when no check came in for this many minutes
MONITOR_SILENT_AFTER_MIN=30
# Monitor script only (npm run monitor): where the MCP server is, the model, the poll interval (clock-aligned:
# 3m runs at :00, :03, :06 …) and the staleness threshold in minutes
MCP_URL=http://localhost:8080/mcp
MONITOR_MODEL=claude-opus-5-5
MONITOR_INTERVAL=3m
MONITOR_THRESHOLD=60
# ANTHROPIC_API_KEY=   (monitor script only; never needed by the server itself)
