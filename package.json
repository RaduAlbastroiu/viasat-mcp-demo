{
  "name": "business-hub-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing the Viasat Business Hub demo data to Claude and other agents",
  "engines": {
    "node": ">=18 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:stdio": "tsx src/index.ts --stdio",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync-data": "tsx scripts/sync-data.ts",
    "smoke": "tsx scripts/smoke.ts",
    "eval": "tsx scripts/eval.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js --stdio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
